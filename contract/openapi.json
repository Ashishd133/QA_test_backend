{
  "components": {
    "schemas": {
      "AssertionData": {
        "properties": {
          "assertionId": {
            "title": "Assertionid",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "triggeredAtTurn": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Triggeredatturn"
          }
        },
        "required": [
          "assertionId",
          "name",
          "status"
        ],
        "title": "AssertionData",
        "type": "object"
      },
      "AttackData": {
        "properties": {
          "agentResponse": {
            "title": "Agentresponse",
            "type": "string"
          },
          "attackPrompt": {
            "title": "Attackprompt",
            "type": "string"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "severity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Severity"
          },
          "verdict": {
            "anyOf": [
              {
                "enum": [
                  "blocked",
                  "leaked",
                  "bypassed"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Verdict"
          }
        },
        "required": [
          "category",
          "attackPrompt",
          "agentResponse"
        ],
        "title": "AttackData",
        "type": "object"
      },
      "DoneData": {
        "description": "Type-specific completion payload (spine \u00a74): populate whichever\nsubset applies to the run's type (simulation | discovery | redteam).",
        "properties": {
          "discoveryResult": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Discoveryresult"
          },
          "exposure": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Exposure"
          },
          "findingsCount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Findingscount"
          },
          "resultBadge": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Resultbadge"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Score"
          }
        },
        "title": "DoneData",
        "type": "object"
      },
      "ErrorData": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "fatal": {
            "default": false,
            "title": "Fatal",
            "type": "boolean"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorData",
        "type": "object"
      },
      "ExposureData": {
        "properties": {
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Counts",
            "type": "object"
          }
        },
        "required": [
          "counts"
        ],
        "title": "ExposureData",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IntentData": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "name",
          "state",
          "path"
        ],
        "title": "IntentData",
        "type": "object"
      },
      "MetricsData": {
        "properties": {
          "avgLatencyMs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Avglatencyms"
          },
          "interruptions": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Interruptions"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Score"
          },
          "turnsCompleted": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Turnscompleted"
          }
        },
        "title": "MetricsData",
        "type": "object"
      },
      "NodeData": {
        "properties": {
          "blockedReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Blockedreason"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "nodeId": {
            "title": "Nodeid",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "x": {
            "title": "X",
            "type": "number"
          },
          "y": {
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "nodeId",
          "label",
          "x",
          "y",
          "state"
        ],
        "title": "NodeData",
        "type": "object"
      },
      "StatusData": {
        "properties": {
          "status": {
            "enum": [
              "queued",
              "claimed",
              "running",
              "completed",
              "cancelled",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "StatusData",
        "type": "object"
      },
      "TurnData": {
        "properties": {
          "flagReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Flagreason"
          },
          "flagged": {
            "default": false,
            "title": "Flagged",
            "type": "boolean"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "latencyMs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latencyms"
          },
          "role": {
            "enum": [
              "caller",
              "agent"
            ],
            "title": "Role",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "index",
          "role",
          "text"
        ],
        "title": "TurnData",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "cadence-brain",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/runs/{run_id}/stream": {
      "get": {
        "operationId": "stream_run",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream Run",
        "tags": [
          "runs"
        ]
      }
    }
  }
}
